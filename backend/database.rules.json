{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      ".indexOn": ["email", "country"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid','firstname','lastname','email','country','state','city']) && newData.child('uid').val() === $uid && newData.child('email').val() === auth.token.email",
        "firstname": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "lastname": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "skills": {
          "$skill": {
            ".validate": "newData.hasChildren(['skillname','proficency']) && newData.child('skillname').val() === $skill && newData.child('proficency').isString() && newData.child('proficency').val().matches(/^(100|[0-9]{1,2})%$/)"
          }
        },
        "country": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "state": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "city": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "birthDate": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "latitude": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "longitude": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        }
      }
    },
    "events": {
      ".read": "auth != null",
      ".indexOn": ["startsAt"],
      "$event": {
        ".write": "auth != null && ((!data.exists() && newData.child('ownerId').val() === auth.uid) || data.child('ownerId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['ownerId','title','location','startsAt','cancelled']) && newData.child('ownerId').val() === auth.uid && (!data.exists() || newData.child('ownerId').val() === data.child('ownerId').val())",
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "location": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 2000"
        },
        "startsAt": {
          ".validate": "newData.isNumber() && (newData.val() > now || newData.val() === data.val())"
        },
        "cancelled": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "attendance": {
      "$event": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (root.child('events').child($event).exists() && root.child('events').child($event).child('cancelled').val() === false && root.child('events').child($event).child('startsAt').val() > now))",
          ".validate": "newData.val() === true"
        }
      }
    },
    "ratings": {
      "$subject": {
        ".read": "auth != null",
        "$peer": {
          "$skill": {
            ".write": "auth != null && auth.uid === $peer && $peer !== $subject && root.child('users').child($subject).child('skills').child($skill).exists()",
            ".validate": "newData.hasChildren(['skill','score','context','updatedAt']) && newData.child('skill').val() === $skill",
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5 && newData.val() % 1 === 0"
            },
            "context": {
              ".validate": "newData.isString() && newData.val().length >= 10 && newData.val().length <= 500"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            }
          }
        }
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null && (!data.exists() || data.child('members').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['first','second','members']) && newData.child('first').isString() && newData.child('second').isString() && newData.child('first').val() !== newData.child('second').val() && $room === newData.child('first').val() + '_' + newData.child('second').val() && newData.child('members').hasChildren([newData.child('first').val(), newData.child('second').val()])",
        "members": {
          "$uid": {
            ".validate": "newData.val() === true && root.child('users').child($uid).exists() && ($uid === newData.parent().parent().child('first').val() || $uid === newData.parent().parent().child('second').val())",
            ".write": "auth != null && newData.val() === true && ((data.val() === true && data.parent().child(auth.uid).val() === true) || (!data.exists() && !data.parent().exists() && newData.parent().child(auth.uid).val() === true))"
          }
        },
        "messages": {
          ".indexOn": ["timestamp"],
          "$message": {
            ".validate": "!data.exists() && newData.hasChildren(['senderUid','receiverUid','message','timestamp']) && newData.child('senderUid').val() === auth.uid && newData.child('receiverUid').val() !== auth.uid && newData.parent().parent().child('members').child(newData.child('receiverUid').val()).val() === true && newData.child('senderMail').val() === auth.token.email && newData.child('receiverMail').val() === root.child('users').child(newData.child('receiverUid').val()).child('email').val() && newData.child('sender').val() === root.child('users').child(auth.uid).child('firstname').val()",
            "message": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4000"
            },
            "timestamp": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            ".write": "auth != null && !data.exists() && newData.exists() && newData.child('senderUid').val() === auth.uid && newData.parent().parent().child('members').child(auth.uid).val() === true"
          }
        },
        "first": {
          ".write": "auth != null && newData.exists() && newData.parent().child('members').child(auth.uid).val() === true && (!data.exists() || newData.val() === data.val())"
        },
        "second": {
          ".write": "auth != null && newData.exists() && newData.parent().child('members').child(auth.uid).val() === true && (!data.exists() || newData.val() === data.val())"
        }
      }
    },
    "deviceTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$token": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === true"
        }
      }
    }
  }
}
