{
  "name": "geekspad-local-backend",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "firebase emulators:start --project demo-geekspad --only auth,database",
    "seed": "node scripts/seed.mjs",
    "test": "firebase emulators:exec --project demo-geekspad --only auth,database 'node --test test/*.test.mjs'"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.1"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
